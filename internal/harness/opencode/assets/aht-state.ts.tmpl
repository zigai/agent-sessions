"{{MANAGED_MARKER}}";
"AHT_INTEGRATION_ID={{INTEGRATION_ID}}";
"AHT_INTEGRATION_VERSION={{INTEGRATION_VERSION}}";
"aht_integration_version={{INTEGRATION_VERSION}}";

import { spawn } from "node:child_process";

const ahtBin = {{BINARY}};
const source = {{SOURCE}};

const commandTimeoutMs = 1000;
const commandKillGraceMs = 100;
const maxPendingReports = 64;
const pendingCommands: string[][] = [];
let commandDrain: Promise<void> | undefined;
let reportingWarningShown = false;

function warnReporting(): void {
  if (reportingWarningShown) return;
  reportingWarningShown = true;
  console.warn("aht: reporting unavailable or overloaded; some state updates may be lost");
}

function runCommand(args: string[]): Promise<void> {
  return new Promise((resolve) => {
    try {
      const child = spawn(ahtBin, args, { stdio: "ignore" });
      let killTimer: ReturnType<typeof setTimeout> | undefined;
      const timeout = setTimeout(() => {
        warnReporting();
        child.kill("SIGTERM");
        killTimer = setTimeout(() => child.kill("SIGKILL"), commandKillGraceMs);
      }, commandTimeoutMs);
      child.once("error", warnReporting);
      child.once("close", (code) => {
        clearTimeout(timeout);
        clearTimeout(killTimer);
        if (code !== 0) warnReporting();
        resolve();
      });
    } catch {
      warnReporting();
      resolve();
    }
  });
}

// The module owns one child and a bounded FIFO. Overload drops the oldest
// unsent observation, preserving the newest/final state and enqueue-time identity.
// Referenced child/timers keep normal process exit from abandoning a report.
function enqueueCommand(args: string[]): Promise<void> {
  if (pendingCommands.length >= maxPendingReports) {
    pendingCommands.shift();
    warnReporting();
  }
  pendingCommands.push(args);
  if (!commandDrain) {
    commandDrain = (async () => {
      try {
        let next: string[] | undefined;
        while ((next = pendingCommands.shift()) !== undefined) await runCommand(next);
      } catch {
        warnReporting();
      } finally {
        commandDrain = undefined;
      }
    })();
  }
  return commandDrain;
}



function firstString(...values: unknown[]): string | undefined {
  for (const value of values) {
    if (typeof value === "string" && value.length > 0) {
      return value;
    }
  }
  return undefined;
}

function valueAt(value: unknown, path: string[]): unknown {
  let current: unknown = value;
  for (const part of path) {
    if (current === undefined || current === null || typeof current !== "object") {
      return undefined;
    }
    current = Object.entries(current).find(([key]) => key === part)?.[1];
  }
  return current;
}

function firstPathString(value: unknown, paths: string[][]): string | undefined {
  return firstString(...paths.map((path) => valueAt(value, path)));
}

function normalizeStatus(value: unknown): string | undefined {
  if (value !== null && typeof value === "object") {
    value = "type" in value ? value.type : undefined;
  }
  if (typeof value !== "string") {
    return undefined;
  }
  const status = value.toLowerCase();
  if (["running", "busy", "retry"].includes(status)) {
    return "running";
  }
  if (["failed", "error", "errored", "crash", "crashed"].includes(status)) {
    return "failed";
  }
  if (["interrupted", "paused", "stopped", "cancelled", "canceled"].includes(status)) {
    return "interrupted";
  }
  if (["waiting", "blocked"].includes(status)) {
    return "waiting";
  }
  if (status === "idle" || status === "offline") {
    return "idle";
  }
  return undefined;
}

function stateForEvent(event: unknown): string | undefined {
  switch (valueAt(event, ["type"])) {
    case "session.created":
      return "idle";
    case "session.deleted":
      return "gone";
    case "session.idle":
      return "idle";
    case "session.error":
    case "error":
      return "failed";
    case "session.interrupted":
      return "interrupted";
    case "permission.asked":
      return "waiting";
    case "permission.replied":
      return "running";
    case "session.status":
      return normalizeStatus(firstPathString(event, [
        ["status", "type"],
        ["properties", "status", "type"],
        ["session", "status", "type"],
        ["status"],
        ["properties", "status"],
        ["session", "status"],
      ]));
    default:
      return undefined;
  }
}

// Consumer-only native plugin contract; event bus payloads are parsed as unknown.
// https://opencode.ai/docs/plugins/ and https://kilo.ai/docs/automate/extending/plugins
type PluginContext = {
  readonly directory?: string | undefined;
  readonly worktree?: string | undefined;
  readonly project?: { readonly path?: string | undefined; readonly root?: string };
};
type PluginHooks = { event(input: { readonly event: unknown }): Promise<void> };
async function AHTPlugin(ctx: PluginContext): Promise<PluginHooks> {
  let currentSessionId: string | undefined;
  let currentSessionPath: string | undefined;
  let currentCwd: string | undefined;
  let currentProjectRoot: string | undefined;

  function refreshSessionRef(event: unknown): void {
    currentSessionId = firstPathString(event, [
      ["sessionID"],
      ["sessionId"],
      ["session_id"],
      ["properties", "sessionID"],
      ["properties", "sessionId"],
      ["properties", "session_id"],
      ["properties", "info", "id"],
      ["properties", "info", "sessionID"],
      ["session", "id"],
      ["session", "sessionID"],
      ["session", "sessionId"],
    ]) ?? currentSessionId;

    currentSessionPath = firstPathString(event, [
      ["sessionPath"],
      ["session_path"],
      ["path"],
      ["properties", "info", "path"],
      ["properties", "info", "file"],
      ["session", "path"],
      ["session", "file"],
    ]) ?? currentSessionPath;

    currentCwd = firstString(
      ctx?.directory,
      ctx?.worktree,
      valueAt(event, ["cwd"]),
      valueAt(event, ["session", "cwd"]),
      valueAt(event, ["properties", "cwd"]),
      valueAt(event, ["properties", "info", "directory"]),
    ) ?? currentCwd;

    currentProjectRoot = firstString(
      ctx?.worktree,
      ctx?.project?.path,
      ctx?.project?.root,
      valueAt(event, ["properties", "info", "directory"]),
    ) ?? currentProjectRoot;
  }

function addAttribute(args: string[], key: string, value: unknown): void {
  if (typeof value === "string" && value.length > 0) {
    args.push("--attribute", `${key}=${value}`);
  }
}

function addEvent(args: string[], value: unknown): void {
  if (typeof value === "string" && value.length > 0) {
    args.push("--event", value);
  }
}

  function report(state: string, event: unknown): Promise<void> {
    const observedAt = new Date().toISOString();
    refreshSessionRef(event);

    const args = ["report", "opencode", state === "gone" ? "--presence" : "--activity", state, "--observed-at", observedAt, "--quiet"];
    addEvent(args, valueAt(event, ["type"]));
    args.push("--attribute", `aht_integration_version={{INTEGRATION_VERSION}}`);
    if (currentSessionId) {
      args.push("--session-id", currentSessionId);
    }
    if (currentSessionPath) {
      args.push("--session-path", currentSessionPath);
    }
    if (currentCwd) {
      args.push("--cwd", currentCwd);
    }
    if (currentProjectRoot) {
      args.push("--project-root", currentProjectRoot);
    }

    addAttribute(args, "opencode_status", firstPathString(event, [
      ["status", "type"],
      ["properties", "status", "type"],
      ["session", "status", "type"],
      ["status"],
      ["properties", "status"],
      ["session", "status"],
    ]));
    addAttribute(args, "aht_integration", source);

    return enqueueCommand(args);
  }

  return {
    event: async ({ event }) => {
      const state = stateForEvent(event);
      if (state === undefined) {
        return;
      }

      await report(state, event);
    },
  };
}

export default { id: "aht-state", server: AHTPlugin };
